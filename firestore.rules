rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'developer'];
    }
    function isValidString(text, min, max) {
      return text is string && text.size() >= min && text.size() <= max;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated(); // Allowed for user management screen
      
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'name', 'avatarUrl', 'role'])
          && data.keys().hasOnly(['uid', 'email', 'name', 'avatarUrl', 'displayName', 'role', 'createdAt', 'state', 'company', 'jobFunction', 'isPreRegistration'])
          && data.uid == userId
          && isValidString(data.email, 0, 150)
          && isValidString(data.name, 0, 150)
          && isValidString(data.avatarUrl, 0, 1500)
          && (!('displayName' in data) || isValidString(data.displayName, 0, 150))
          && data.role in ['admin', 'analyst', 'viewer']
          && (!('createdAt' in data) || data.createdAt is string || data.createdAt is number)
          && (!('state' in data) || isValidString(data.state, 0, 150))
          && (!('company' in data) || isValidString(data.company, 0, 150))
          && (!('jobFunction' in data) || isValidString(data.jobFunction, 0, 150))
          && (!('isPreRegistration' in data) || data.isPreRegistration is bool);
      }
      
      allow create: if ((isOwner(userId) && request.resource.data.role == 'viewer') || isAdmin()) && isValidUser(request.resource.data);
      allow update: if (isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role && request.resource.data.uid == resource.data.uid)) && isValidUser(request.resource.data);
      allow delete: if isAdmin();

      match /private/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Legacy Reports subcollection - for migration
      match /reports/{reportId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Prompts subcollection
      match /prompts/{promptId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId);
        allow update: if false; // Prompts are immutable
        allow delete: if isOwner(userId);
      }
    }

    // Archive Users collection
    match /archived_users/{userId} {
      allow read, write: if isAdmin();
    }

    // Reports collection (Shared across all users)
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      
      function isValidReport(data) {
        return data.keys().hasAll(['id', 'userId', 'editalName', 'candidateName', 'timestamp'])
          && data.keys().hasOnly(['id', 'userId', 'editalName', 'candidateName', 'cnpj', 'timestamp', 'result', 'manualStatus', 'userNotes', 'promptId', 'evaluatedBy', 'evaluatedAt', 'overallStatus', 'documentHash', 'editalId', 'propostaId'])
          && isValidString(data.id, 1, 100)
          && isValidString(data.userId, 1, 100)
          && isValidString(data.editalName, 0, 500)
          && isValidString(data.candidateName, 0, 500)
          && (!('cnpj' in data) || data.cnpj == null || isValidString(data.cnpj, 0, 50))
          && data.timestamp is number
          && data.timestamp > 0
          && (!('result' in data) || data.result == null || isValidString(data.result, 2, 800000))
          && (!('manualStatus' in data) || data.manualStatus == null || isValidString(data.manualStatus, 0, 50))
          && (!('overallStatus' in data) || data.overallStatus == null || isValidString(data.overallStatus, 0, 50))
          && (!('documentHash' in data) || data.documentHash == null || isValidString(data.documentHash, 0, 200))
          && (!('userNotes' in data) || data.userNotes == null || isValidString(data.userNotes, 0, 5000))
          && (!('promptId' in data) || data.promptId == null || isValidString(data.promptId, 0, 100))
          && (!('evaluatedBy' in data) || data.evaluatedBy == null || isValidString(data.evaluatedBy, 0, 150))
          && (!('evaluatedAt' in data) || data.evaluatedAt == null || data.evaluatedAt is number)
          && (!('editalId' in data) || data.editalId == null || isValidString(data.editalId, 0, 200))
          && (!('propostaId' in data) || data.propostaId == null || isValidString(data.propostaId, 0, 200));
      }

      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidReport(request.resource.data);
        
      allow update: if isAuthenticated()
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.timestamp == resource.data.timestamp
        && isValidReport(request.resource.data);
        
      allow delete: if isAuthenticated() && (isAdmin() || request.auth.uid == resource.data.userId);

      // Detailed subcollection of a report
      match /details/{detailId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && detailId == 'content' && (
          !exists(/databases/$(database)/documents/reports/$(reportId)) ||
          get(/databases/$(database)/documents/reports/$(reportId)).data.userId == request.auth.uid
        );
        allow delete: if isAuthenticated() && (
          !exists(/databases/$(database)/documents/reports/$(reportId)) ||
          get(/databases/$(database)/documents/reports/$(reportId)).data.userId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Audit logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // AI Usage logs
    match /ai_usage_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Global Prompts collection
    
    // Prompt Modules collection
    match /prompt_modules/{moduleId} {
      allow read: if isAuthenticated();

      function isValidPromptModule(data) {
        return data.keys().hasAll(['id', 'documentType', 'description', 'promptInstructions', 'timestamp'])
          && data.keys().hasOnly(['id', 'documentType', 'description', 'promptInstructions', 'timestamp', 'updatedBy'])
          && isValidString(data.id, 1, 100)
          && isValidString(data.documentType, 1, 200)
          && isValidString(data.description, 0, 1000)
          && isValidString(data.promptInstructions, 0, 10000)
          && data.timestamp is number
          && (!('updatedBy' in data) || isValidString(data.updatedBy, 0, 150));
      }

      allow create: if isAdmin() && isValidPromptModule(request.resource.data);
      allow update: if isAdmin() && isValidPromptModule(request.resource.data);
      allow delete: if isAdmin();
    }

    match /global_prompts/{promptId} {
      allow read: if isAuthenticated();

      allow create, update: if isAdmin() && request.resource.data.id == promptId;
      allow delete: if false;
    }

    // Ideas collection
    match /ideas/{ideaId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && isOwner(resource.data.userId);
        allow delete: if isAuthenticated() && isOwner(resource.data.userId);
      }
    }

    // Repository folders
    match /repository_folders/{folderId} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Repository files
    match /repository_files/{fileId} {
      allow read, update, delete: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      match /chunks/{chunkId} {
        allow read, update, delete: if isAdmin() || isOwner(get(/databases/$(database)/documents/repository_files/$(fileId)).data.userId);
        allow create: if isAuthenticated() && get(/databases/$(database)/documents/repository_files/$(fileId)).data.userId == request.auth.uid;
      }
    }
    // Edital Settings Cache
    match /edital_settings/{editalId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // AI Audits Cache
    match /ai_audits_cache/{cacheId} {
      allow read, write: if request.auth != null;
    }
  }
}
